PORT=4000

# SECURITY: Generate a strong random secret (min 32 chars). Example: openssl rand -base64 48
JWT_SECRET=CHANGE_ME_GENERATE_STRONG_SECRET

ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=14

# CORS: comma-separated list of allowed origins. NEVER use '*' in production.
CORS_ORIGINS=http://localhost:3000

# SECURITY: Set to true in production (requires HTTPS)
COOKIE_SECURE=false
COOKIE_SAMESITE=Lax

DEVICE_OFFLINE_MINUTES=10
DEVICE_TAMPER_IMPOSSIBLE_SPEED_KMH=140
DEVICE_TAMPER_IDENTITY_MISMATCH_THRESHOLD=3
SLA_ACK_MINUTES=5
SLA_RESOLVE_MINUTES=30

REDIS_HEALTH_URL=tcp://127.0.0.1:6379
RULES_ENGINE_HEALTH_URL=http://127.0.0.1:4100/health
NOTIFICATION_SERVICE_HEALTH_URL=http://127.0.0.1:4101/health
SERVICE_HEALTH_TIMEOUT_MS=1500
PLAYBACK_MAX_RANGE_HOURS=24
PLAYBACK_MAX_POINTS=5000

MAP_MATCHING_PROVIDER=local_postgis
MAP_MATCHING_MAX_SNAP_DISTANCE_METERS=80
MAP_MATCHING_MIN_CONFIDENCE=0.35

TELEMETRY_TARGET_INTERVAL_SEC=5
TELEMETRY_QUALITY_DRIFT_THRESHOLD_M=80
TELEMETRY_QUALITY_SLA_TARGET_PCT=99.5
TELEMETRY_RATE_LIMIT_WINDOW_MS=60000
TELEMETRY_RATE_LIMIT_MAX=120

# SECURITY: At least one MUST be set for telemetry authentication
TELEMETRY_INGEST_TOKEN=CHANGE_ME_GENERATE_TOKEN
# TELEMETRY_HMAC_SECRET=CHANGE_ME_GENERATE_HMAC_SECRET

# Rate limiting
GLOBAL_RATE_LIMIT_WINDOW_MS=60000
GLOBAL_RATE_LIMIT_MAX=100
LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_MAX=10

# Object storage (S3/MinIO)
S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
# SECURITY: Change these from default MinIO credentials
S3_ACCESS_KEY_ID=CHANGE_ME
S3_SECRET_ACCESS_KEY=CHANGE_ME
PLAYBACK_RECORD_BUCKET=playback-records
PUBLIC_REPORT_BUCKET=public-report-evidence
PUBLIC_REPORT_MAX_ATTACHMENT_MB=5
PUBLIC_REPORT_MAX_ATTACHMENTS=3
PUBLIC_REPORT_RATE_LIMIT_WINDOW_MS=600000
PUBLIC_REPORT_RATE_LIMIT_MAX=5
PUBLIC_REPORT_REVIEW_ENABLED=true
PUBLIC_REPORT_REVIEW_INTERVAL_MS=300000
PUBLIC_REPORT_REVIEW_BATCH_SIZE=25
PUBLIC_REPORT_REVIEW_CONCURRENCY=3
PUBLIC_REPORT_EVIDENCE_PROCESSING_ENABLED=true
PUBLIC_REPORT_EVIDENCE_CONCURRENCY=2
PUBLIC_REPORT_EVIDENCE_THUMBNAIL_MAX_WIDTH=480
PUBLIC_REPORT_EVIDENCE_THUMBNAIL_MAX_HEIGHT=480
PUBLIC_REPORT_EVIDENCE_THUMBNAIL_QUALITY=80
PUBLIC_REPORT_REVIEW_WINDOW_MINUTES=15
PUBLIC_REPORT_REVIEW_RECENT_MINUTES=30
PUBLIC_REPORT_REVIEW_MAX_DISTANCE_METERS=250
PUBLIC_REPORT_REVIEW_STALE_VEHICLE_MINUTES=20
PUBLIC_REPORT_REVIEW_NGETEM_LOW_SPEED_KMH=3
PUBLIC_REPORT_REVIEW_NGETEM_MIN_STOP_MINUTES=10
PUBLIC_REPORT_REVIEW_OVERSPEED_KMH=60
PUBLIC_REPORT_REVIEW_OFFICIAL_STOP_RADIUS_METERS=75
PASSENGER_TRACKING_TOKEN_TTL_DAYS=30
# Demo-friendly default: OPERATOR can see passenger markers but identity is masked.
# For production, set PASSENGER_LOCATION_REQUIRE_SCOPE_FOR_OPERATOR=true and require route_id/bbox-scoped reads.
PASSENGER_LOCATION_MASK_OPERATOR_IDENTITY=true
PASSENGER_LOCATION_REQUIRE_SCOPE_FOR_OPERATOR=false

# Database - SECURITY: Use strong credentials in production
DB_HOST=localhost
DB_PORT=5432
DB_USER=monitoring
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD
DB_NAME=Sentra

# Redis password (optional for dev, required for production)
# REDIS_PASSWORD=CHANGE_ME

# Optional: use DATABASE_URL instead of the fields above
# DATABASE_URL=postgres://user:password@localhost:5432/Sentra

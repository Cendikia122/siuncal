# =============================================================================
# Docker Compose Environment Variables
# Copy this file to .env and adjust values as needed
#
# ⚠ SECURITY: Change ALL default credentials before deploying to production!
# =============================================================================

# Database — CHANGE PASSWORD IN PRODUCTION
POSTGRES_USER=monitoring
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD
POSTGRES_DB=Sentra
POSTGRES_PORT=5433
PGBOUNCER_PORT=6432
PGBOUNCER_MAX_CLIENT_CONN=500
PGBOUNCER_DEFAULT_POOL_SIZE=50
PGBOUNCER_MIN_POOL_SIZE=10
PGBOUNCER_RESERVE_POOL_SIZE=10
DB_POOL_MAX=50
RULES_DB_POOL_MAX=10
NOTIFICATION_DB_POOL_MAX=10
# Compose routes services to PgBouncer over the private Docker network.
DB_SSL=false

# Redis — set password for production. Compose binds this port to 127.0.0.1 only.
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD

# API Gateway
API_GATEWAY_PORT=4000
# SECURITY: Generate with: openssl rand -base64 48
JWT_SECRET=CHANGE_ME_GENERATE_STRONG_SECRET
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=14
CORS_ORIGINS=http://localhost:3000
# SECURITY: Set to true when using HTTPS
COOKIE_SECURE=false
COOKIE_SAMESITE=Lax
PUBLIC_VEHICLES_CACHE_TTL_SEC=3
PUBLIC_VEHICLES_CDN_CACHE_TTL_SEC=5
DEVICE_OFFLINE_MINUTES=10
DEVICE_TAMPER_IMPOSSIBLE_SPEED_KMH=140
DEVICE_TAMPER_IDENTITY_MISMATCH_THRESHOLD=3
SLA_ACK_MINUTES=5
SLA_RESOLVE_MINUTES=30
PLAYBACK_MAX_RANGE_HOURS=24
PLAYBACK_MAX_POINTS=5000
MAP_MATCHING_PROVIDER=local_postgis
MAP_MATCHING_MAX_SNAP_DISTANCE_METERS=150
MAP_MATCHING_MIN_CONFIDENCE=0.35
TELEMETRY_TARGET_INTERVAL_SEC=5
TELEMETRY_QUALITY_DRIFT_THRESHOLD_M=80
TELEMETRY_QUALITY_SLA_TARGET_PCT=99.5
OFF_ROUTE_METERS=15
WRONG_DIRECTION_GRACE_MINUTES=3
WRONG_DIRECTION_MIN_POINTS=3
WRONG_DIRECTION_HEADING_DIFF_DEGREES=120
WRONG_DIRECTION_MIN_SPEED_KMH=5
REALTIME_PUBSUB_ENABLED=true
REALTIME_BROADCAST_CHANNEL=realtime:broadcast
REALTIME_BROADCAST_LOCK_KEY=realtime:broadcast:leader
REALTIME_BROADCAST_LOCK_TTL_MS=2750

# SECURITY: At least one MUST be set for telemetry authentication.
# Static token is fine for the simulator/dev. For PRODUCTION GPS devices prefer
# HMAC (TELEMETRY_HMAC_SECRET): signed, timestamped, replay-protected.
TELEMETRY_INGEST_TOKEN=CHANGE_ME_GENERATE_TOKEN
# Production telemetry HMAC (generate with: openssl rand -base64 48). Leave empty to use static token.
TELEMETRY_HMAC_SECRET=
SIMULATOR_INTERVAL_MS=5000

# Rate limiting
GLOBAL_RATE_LIMIT_WINDOW_MS=60000
GLOBAL_RATE_LIMIT_MAX=100
LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_MAX=10

# MinIO / Object Storage — CHANGE CREDENTIALS IN PRODUCTION.
# Compose binds these ports to 127.0.0.1 only; use SSH tunnel/VPN for remote admin access.
MINIO_ROOT_USER=CHANGE_ME_MINIO_USER
MINIO_ROOT_PASSWORD=CHANGE_ME_MINIO_PASSWORD
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
PLAYBACK_RECORD_BUCKET=playback-records
PUBLIC_REPORT_BUCKET=public-report-evidence
PUBLIC_REPORT_MAX_ATTACHMENT_MB=5
PUBLIC_REPORT_MAX_ATTACHMENTS=3
PUBLIC_REPORT_RATE_LIMIT_WINDOW_MS=600000
PUBLIC_REPORT_RATE_LIMIT_MAX=5
PUBLIC_REPORT_REVIEW_ENABLED=true
PUBLIC_REPORT_REVIEW_INTERVAL_MS=300000
PUBLIC_REPORT_REVIEW_BATCH_SIZE=25
PUBLIC_REPORT_REVIEW_CONCURRENCY=3
PUBLIC_REPORT_REVIEW_WINDOW_MINUTES=15
PUBLIC_REPORT_REVIEW_RECENT_MINUTES=30
PUBLIC_REPORT_REVIEW_MAX_DISTANCE_METERS=250
PUBLIC_REPORT_REVIEW_STALE_VEHICLE_MINUTES=20
PUBLIC_REPORT_REVIEW_NGETEM_LOW_SPEED_KMH=3
PUBLIC_REPORT_REVIEW_NGETEM_MIN_STOP_MINUTES=10
PUBLIC_REPORT_REVIEW_OVERSPEED_KMH=60
PUBLIC_REPORT_REVIEW_OFFICIAL_STOP_RADIUS_METERS=75
PASSENGER_TRACKING_TOKEN_TTL_DAYS=30
PASSENGER_INTERVAL_MS=5000
PASSENGER_MOVE_FACTOR=0.25
# SECURITY: Change simulator password
PASSENGER_SEED_PASSWORD=CHANGE_ME_SEED_PASSWORD

# Operator Web
OPERATOR_WEB_PORT=3000
# SECURITY: Use https:// and wss:// in production
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
NEXT_PUBLIC_WS_URL=ws://localhost:4000/realtime

# Worker process split (WS3): run BullMQ workers (heatmap, public-report review)
# in a dedicated container instead of inside api-gateway. Set false on api-gateway
# when scaling it horizontally; the `worker` service runs them with true.
RUN_WORKERS=false

# =============================================================================
# PRODUCTION OVERRIDES (uncomment / set when deploying behind HTTPS reverse proxy)
# =============================================================================
# NODE_ENV=production
# COOKIE_SECURE=true
# Reverse proxy (Caddy, run with `--profile proxy`): set real domains for auto Let's Encrypt
# SENTRA_DOMAIN=sentra.example.go.id
# SENTRA_API_DOMAIN=api.sentra.example.go.id
# NEXT_PUBLIC_API_BASE_URL=https://api.sentra.example.go.id
# NEXT_PUBLIC_WS_URL=wss://api.sentra.example.go.id/realtime
# CORS_ORIGINS=https://sentra.example.go.id
# TELEMETRY_HMAC_SECRET=<openssl rand -base64 48>
# TRUST_PROXY_HOPS=1   # api-gateway trusts X-Forwarded-For from Caddy (default 1)
# See docs/runbooks/security-hardening.md and docs/runbooks/scale-out.md
